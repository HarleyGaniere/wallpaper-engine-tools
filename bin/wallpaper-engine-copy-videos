"""Copy the video wallpapers from a Wallpaper Engine Workshop folder into one folder.

This one file provides two commands; which one runs depends on the name it
is called by:

    wallpaper-engine-copy-videos [workshop_folder ...] [-o output_folder] [--dry-run]
        Copies every video exactly as it is. No ffmpeg needed.

    wallpaper-engine-copy-videos-optimized [workshop_folder ...] [-o output_folder]
            [--1080p | --1440p | --4k] [--hevc] [--only-bloated]
            [--crf N] [--preset P] [--dry-run]
        Copies them as MP4, optimizing badly encoded ones along the way.

Both find every wallpaper whose project.json says "type": "video" and name
its video after the wallpaper's title ("Rainy Night.mp4"; the Workshop ID is
added when two titles match).

With -optimized, each video is checked with ffprobe and only re-encoded
(to H.264, or HEVC with --hevc) when something is wrong with it:
  * a codec that isn't the target codec
  * 10-bit or 4:2:2 / 4:4:4 color, which many decoders handle poorly
  * a bitrate far higher than the resolution needs (see BLOATED_BPP)
  * more than 60 frames per second
  * interlaced video
  * larger than the --1080p / --1440p / --4k limit, if one is given
    (shrunk to fit, keeping its shape; smaller videos are never upscaled)
Videos that are fine but not "fast start" or not MP4 are remuxed without
re-encoding. Everything else is copied as is. When a re-encode is only about
saving space (a bloated bitrate, or H.264 to HEVC) and doesn't come out
smaller, the original is kept.

--only-bloated re-encodes nothing but bloated videos (plus the resolution
limit, if given) and copies everything else unchanged.

Without a workshop folder it looks in the usual Steam locations (native,
Debian/Ubuntu and Flatpak). The default output is
~/Pictures/Wallpapers/WallpaperEngineVideos. The -optimized command needs
ffmpeg and ffprobe.
"""
import argparse
import json
import os
import re
import shutil
import struct
import subprocess
import sys

WORKSHOP_SUFFIX = "steamapps/workshop/content/431960"
STEAM_ROOTS = [
    "~/.local/share/Steam",
    "~/.steam/steam",
    "~/.steam/debian-installation",
    "~/.var/app/com.valvesoftware.Steam/.local/share/Steam",
    "~/.var/app/com.valvesoftware.Steam/data/Steam",
]
DEFAULT_OUTPUT = "~/Pictures/Wallpapers/WallpaperEngineVideos"

MAX_FPS = 60
# "Bloated" thresholds in bits per pixel per frame (bitrate / (width x height x fps)).
# A good H.264 encode of a wallpaper sits around 0.05-0.15 and HEVC around half
# that, so these flag files at roughly 2-3x the size they need to be: about
# 19 Mb/s (140 MB a minute) for 1080p30 H.264, or 75 Mb/s for 4K30.
BLOATED_BPP = {"h264": 0.30, "hevc": 0.15, "vp9": 0.15, "av1": 0.10}
BLOATED_BPP_OTHER = 0.30
RESOLUTIONS = {"1080p": (1920, 1080), "1440p": (2560, 1440), "4k": (3840, 2160)}
ENCODERS = {
    # codec: (ffmpeg encoder, default CRF, extra args)
    "h264": ("libx264", 18, ["-profile:v", "high"]),
    "hevc": ("libx265", 22, ["-tag:v", "hvc1", "-x265-params", "log-level=error"]),
}
GOOD_PIX_FMTS = {"yuv420p", "yuvj420p"}
MP4_AUDIO = {"aac", "mp3", "ac3", "eac3", "alac", "opus", "flac"}


# --------------------------------------------------------------------------
# Finding video wallpapers
# --------------------------------------------------------------------------
def find_workshop_folders():
    found, seen = [], set()
    for root in STEAM_ROOTS:
        path = os.path.join(os.path.expanduser(root), WORKSHOP_SUFFIX)
        if os.path.isdir(path):
            real = os.path.realpath(path)
            if real not in seen:
                seen.add(real)
                found.append(path)
    return found


def safe_filename(text):
    text = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", text).strip().strip(".")
    return text or "untitled"


def read_project(folder):
    try:
        with open(os.path.join(folder, "project.json"), encoding="utf-8-sig") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def video_wallpapers(workshop):
    """Yields (workshop_id, title, video_path) for each video wallpaper."""
    for wid in sorted(os.listdir(workshop)):
        folder = os.path.join(workshop, wid)
        if not os.path.isdir(folder):
            continue
        project = read_project(folder)
        if not project or str(project.get("type", "")).lower() != "video":
            continue
        video = os.path.join(folder, str(project.get("file", "")))
        if not project.get("file") or not os.path.isfile(video):
            print(f"! {wid}: video file missing, skipped")
            continue
        yield wid, str(project.get("title") or wid), video


# --------------------------------------------------------------------------
# Inspecting a video
# --------------------------------------------------------------------------
def probe(path):
    out = subprocess.run(
        ["ffprobe", "-v", "error", "-print_format", "json",
         "-show_format", "-show_streams", path],
        capture_output=True, text=True)
    if out.returncode != 0:
        return None
    try:
        return json.loads(out.stdout)
    except ValueError:
        return None


def parse_rate(text):
    try:
        num, _, den = str(text).partition("/")
        num, den = float(num), float(den or 1)
        return num / den if den else 0.0
    except ValueError:
        return 0.0


def is_faststart(path):
    """True if the MP4 index ('moov') comes before the media data ('mdat')."""
    try:
        with open(path, "rb") as f:
            while True:
                head = f.read(8)
                if len(head) < 8:
                    return False
                size, kind = struct.unpack(">I4s", head)
                if kind == b"moov":
                    return True
                if kind == b"mdat":
                    return False
                if size == 1:
                    size = struct.unpack(">Q", f.read(8))[0]
                    f.seek(size - 16, 1)
                elif size == 0:
                    return False
                else:
                    f.seek(size - 8, 1)
    except (OSError, struct.error):
        return False


class Plan:
    def __init__(self):
        self.reencode = []   # reasons that need a re-encode
        self.remux = []      # reasons fixed by remuxing alone
        self.optional_only = False  # every reason is only about saving space
        self.scale = None    # (max_width, max_height) to fit within
        self.fps_cap = False
        self.deinterlace = False
        self.copy_audio = True
        self.has_audio = False
        self.summary = ""


def plan_for(path, info, opts):
    """opts: .codec ("h264"/"hevc"), .max_res (w, h) or None, .only_bloated"""
    p = Plan()
    streams = info.get("streams", [])
    video = next((s for s in streams if s.get("codec_type") == "video"
                  and not s.get("disposition", {}).get("attached_pic")), None)
    audio = next((s for s in streams if s.get("codec_type") == "audio"), None)
    if video is None:
        p.reencode.append("no video stream found")
        return p

    codec = video.get("codec_name", "?")
    w, h = int(video.get("width") or 0), int(video.get("height") or 0)
    fps = parse_rate(video.get("avg_frame_rate")) or parse_rate(video.get("r_frame_rate"))
    pix = video.get("pix_fmt", "")
    rate = video.get("bit_rate") or info.get("format", {}).get("bit_rate")
    bitrate = float(rate) if rate and str(rate).isdigit() else 0.0
    p.summary = f"{codec} {w}x{h} {fps:.0f}fps {pix} {bitrate / 1e6:.1f} Mb/s"

    bloated = False
    if w and h and fps and bitrate:
        bpp = bitrate / (w * h * min(fps, MAX_FPS))
        bloated = bpp > BLOATED_BPP.get(codec, BLOATED_BPP_OTHER)

    optional = 0   # reasons that are only about file size
    if not opts.only_bloated:
        if codec != opts.codec:
            p.reencode.append(f"{codec} codec")
            # To H.264 it's for easier playback (keep it); to HEVC it's for size
            optional += opts.codec == "hevc" and codec == "h264"
        if pix and pix not in GOOD_PIX_FMTS:
            p.reencode.append(f"{pix} color")
        if fps > MAX_FPS + 0.5:
            p.reencode.append(f"{fps:.0f} fps")
            p.fps_cap = True
        if video.get("field_order") not in (None, "", "progressive", "unknown"):
            p.reencode.append("interlaced")
            p.deinterlace = True
    if opts.max_res and (w > opts.max_res[0] or h > opts.max_res[1]):
        p.reencode.append(f"{w}x{h} > {opts.max_res[0]}x{opts.max_res[1]}")
        p.scale = opts.max_res
    if bloated:
        p.reencode.append(f"bloated ({bitrate / 1e6:.0f} Mb/s)")
        optional += 1
    p.optional_only = bool(p.reencode) and optional == len(p.reencode)

    if audio is not None:
        p.has_audio = True
        p.copy_audio = audio.get("codec_name") in MP4_AUDIO

    if not opts.only_bloated:
        fmt = info.get("format", {}).get("format_name", "")
        if "mp4" not in fmt and "mov" not in fmt:
            p.remux.append("not an MP4 file")
        elif not is_faststart(path):
            p.remux.append("not fast-start")
        if p.has_audio and not p.copy_audio:
            p.remux.append(f"{audio.get('codec_name')} audio")
    return p


# --------------------------------------------------------------------------
# Writing the output
# --------------------------------------------------------------------------
def run_ffmpeg(args, dest):
    tmp = dest + ".part.mp4"
    try:
        subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *args, tmp],
                       check=True)
    except (OSError, subprocess.CalledProcessError):
        if os.path.exists(tmp):
            os.remove(tmp)
        raise
    return tmp


def audio_args(plan):
    if not plan.has_audio:
        return ["-an"]
    return ["-c:a", "copy"] if plan.copy_audio else ["-c:a", "aac", "-b:a", "192k"]


def remux(src, dest, plan):
    return run_ffmpeg(["-i", src, "-map", "0:v:0", "-map", "0:a:0?", "-c:v", "copy",
                       *audio_args(plan), "-movflags", "+faststart"], dest)


def reencode(src, dest, plan, opts):
    encoder, default_crf, extra = ENCODERS[opts.codec]
    crf = opts.crf if opts.crf is not None else default_crf
    filters = []
    if plan.deinterlace:
        filters.append("bwdif")
    if plan.fps_cap:
        filters.append(f"fps={MAX_FPS}")
    if plan.scale:
        mw, mh = plan.scale
        # Fit inside the box, keeping the aspect ratio (no cropping)
        filters.append(f"scale={mw}:{mh}:force_original_aspect_ratio=decrease:"
                       "force_divisible_by=2")
    filters.append("format=yuv420p")
    return run_ffmpeg(["-i", src, "-map", "0:v:0", "-map", "0:a:0?",
                       "-vf", ",".join(filters),
                       "-c:v", encoder, "-preset", opts.preset, "-crf", str(crf),
                       *extra, "-pix_fmt", "yuv420p",
                       *audio_args(plan), "-movflags", "+faststart"], dest)


def process(src, dest, plan, opts):
    """Returns a short description of what was done."""
    if plan is None:
        shutil.copy2(src, dest)
        return "copied"

    note = ""
    if plan.reencode:
        tmp = reencode(src, dest, plan, opts)
        if plan.optional_only and os.path.getsize(tmp) >= os.path.getsize(src):
            # The re-encode was only meant to save space and didn't; keep the original
            os.remove(tmp)
            note = f" ({opts.codec.upper()} re-encode wasn't smaller, kept the original)"
        else:
            os.replace(tmp, dest)
            return f"re-encoded to {opts.codec.upper()}: {', '.join(plan.reencode)} [{plan.summary}]"

    if plan.remux:
        os.replace(remux(src, dest, plan), dest)
        return f"remuxed: {', '.join(plan.remux)}{note}"

    shutil.copy2(src, dest)
    return "copied" + (note or " (already well encoded)")


def human(n):
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024


def main():
    prog = os.path.basename(sys.argv[0])
    optimized = prog.endswith("-optimized")
    ap = argparse.ArgumentParser(
        prog=prog,
        description=("Copy Wallpaper Engine video wallpapers into one folder as MP4, "
                     "optimizing badly encoded ones." if optimized else
                     "Copy Wallpaper Engine video wallpapers into one folder, unchanged."))
    ap.add_argument("workshop", nargs="*",
                    help="Workshop folder(s) (.../steamapps/workshop/content/431960); "
                         "default: search the usual Steam locations")
    ap.add_argument("-o", "--output", default=DEFAULT_OUTPUT,
                    help=f"destination folder (default {DEFAULT_OUTPUT})")
    if optimized:
        size = ap.add_mutually_exclusive_group()
        size.add_argument("--1080p", dest="max_res", action="store_const", const="1080p",
                          help="shrink videos larger than 1920x1080 to fit 1080p")
        size.add_argument("--1440p", dest="max_res", action="store_const", const="1440p",
                          help="shrink videos larger than 2560x1440 to fit 1440p")
        size.add_argument("--4k", "--4K", dest="max_res", action="store_const", const="4k",
                          help="shrink videos larger than 3840x2160 to fit 4K")
        ap.add_argument("--hevc", "--HEVC", action="store_true",
                        help="encode to HEVC (H.265) instead of H.264: much smaller files, "
                             "but heavier to play without hardware HEVC decoding")
        ap.add_argument("--only-bloated", action="store_true",
                        help="only re-encode videos whose bitrate is far too high; "
                             "copy everything else unchanged")
        ap.add_argument("--crf", type=int, default=None,
                        help="quality: lower = better and bigger "
                             "(default 18 for H.264, 22 for HEVC)")
        ap.add_argument("--preset", default="veryfast",
                        help="encoder speed: slower presets (medium, slow) make smaller "
                             "files at the same quality but take longer (default veryfast)")
    ap.add_argument("--overwrite", action="store_true",
                    help="redo videos that are already in the output folder")
    ap.add_argument("--dry-run", action="store_true",
                    help="show what would be done without writing anything")
    a = ap.parse_args()
    a.codec = "hevc" if getattr(a, "hevc", False) else "h264"
    a.max_res = RESOLUTIONS.get(getattr(a, "max_res", None) or "")
    a.only_bloated = getattr(a, "only_bloated", False)
    a.crf = getattr(a, "crf", None)
    a.preset = getattr(a, "preset", "veryfast")

    if optimized:
        if not (shutil.which("ffmpeg") and shutil.which("ffprobe")):
            sys.exit("Optimizing needs ffmpeg and ffprobe. Install ffmpeg, or use "
                     "wallpaper-engine-copy-videos to copy the videos as they are.")
        encoder = ENCODERS[a.codec][0]
        encoders = subprocess.run(["ffmpeg", "-hide_banner", "-encoders"],
                                  capture_output=True, text=True).stdout
        if encoder not in encoders:
            sys.exit(f"Your ffmpeg has no {encoder} encoder. On Fedora, install the full "
                     "ffmpeg from RPM Fusion: sudo dnf swap ffmpeg-free ffmpeg --allowerasing")

    workshops = a.workshop or find_workshop_folders()
    if not workshops:
        sys.exit("No Workshop folder found. Give its path, e.g. "
                 f"~/.local/share/Steam/{WORKSHOP_SUFFIX}")

    out = os.path.expanduser(a.output)
    if not a.dry_run:
        os.makedirs(out, exist_ok=True)

    items = []
    for ws in workshops:
        if not os.path.isdir(ws):
            sys.exit(f"Not a folder: {ws}")
        print(f"Scanning {ws}")
        items.extend(video_wallpapers(ws))

    counts = {}
    for _, title, _ in items:
        key = safe_filename(title).lower()
        counts[key] = counts.get(key, 0) + 1

    done = skipped = failed = 0
    size_in = size_out = 0
    for wid, title, src in items:
        base = safe_filename(title)
        if counts[base.lower()] > 1:
            base = f"{base} ({wid})"

        plan = None
        if optimized:
            info = probe(src)
            if info is not None:
                plan = plan_for(src, info, a)
        src_ext = os.path.splitext(src)[1] or ".mp4"
        changes = plan is not None and (plan.reencode or plan.remux)
        dest = os.path.join(out, base + (".mp4" if changes else src_ext))

        if os.path.exists(dest) and not a.overwrite:
            skipped += 1
            continue

        if a.dry_run:
            if plan and plan.reencode:
                what = f"re-encode to {a.codec.upper()}: {', '.join(plan.reencode)} [{plan.summary}]"
            elif plan and plan.remux:
                what = f"remux: {', '.join(plan.remux)}"
            else:
                what = "copy"
            print(f"* {title} -> {os.path.basename(dest)}: would {what}")
            done += 1
            continue

        print(f"* {title} -> {os.path.basename(dest)} ...", flush=True)
        try:
            result = process(src, dest, plan, a)
            size_in += os.path.getsize(src)
            size_out += os.path.getsize(dest)
            print(f"  {result}  ({human(os.path.getsize(src))} -> {human(os.path.getsize(dest))})")
            done += 1
        except (OSError, subprocess.CalledProcessError) as e:
            print(f"! Failed: {title}: {e}")
            failed += 1

    verb = "Would process" if a.dry_run else "Processed"
    print(f"\n{verb} {done}, skipped {skipped} already there"
          + (f", {failed} failed" if failed else "") + f" -> {out}")
    if size_in:
        print(f"Total size: {human(size_in)} -> {human(size_out)}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
